<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <!-- Override the unlisted nightly dependency from MessageBox.Avalonia. -->
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneHub.Diagnostics.HeapView\OneHub.Diagnostics.HeapView.csproj" />
  </ItemGroup>

</Project>
